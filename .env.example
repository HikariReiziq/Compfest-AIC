# ============ App ============
APP_NAME="COBA API"
ENV=local                      # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ============ Security ============
# WAJIB diganti di staging/production. Generate: openssl rand -hex 32
JWT_SECRET=change-me-please-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900          # 15 menit
REFRESH_TOKEN_TTL_SECONDS=1209600     # 14 hari
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MAX_REQUEST_BODY_BYTES=2097152        # 2 MiB

# ============ Postgres ============
DATABASE_URL=postgresql+asyncpg://coba:coba@localhost:5432/coba
# Opsional: read replica untuk memisahkan trafik baca katalog
DATABASE_REPLICA_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=5000

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_CATALOG_SECONDS=3600
CACHE_TTL_RECOMMENDATION_SECONDS=300
CACHE_TTL_NEGATIVE_SECONDS=30
CACHE_LOCK_TIMEOUT_SECONDS=5

# ============ Sesi try-on (ephemeral, tidak masuk Postgres) ============
SESSION_TTL_SECONDS=1800              # 30 menit sliding window
SESSION_MAX_FEEDBACK=200

# ============ Rate limit ============
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANON_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=240
RATE_LIMIT_LOGIN_PER_MINUTE=5

# ============ AI ============
RECOMMENDER_BACKEND=heuristic         # heuristic | remote
RECOMMENDER_TIMEOUT_SECONDS=2.5
RECOMMENDER_REMOTE_URL=
FEEDBACK_AGGREGATE_ENABLED=true       # simpan agregat anonim untuk pembelajaran lintas sesi
