# ==============================================================================
# COBA - Environment Variables Configuration
# Salin file ini menjadi .env (cp .env.example .env)
# ==============================================================================

# Google Gemini API Key (Opsional - Stylist Reason Generator LLM)
# Jika dikosongkan, sistem secara otomatis menggunakan Intelligent Rule-Based Fallback Engine
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Mode Evaluasi Cepat Juri (MOCK_MODE=false: Menggunakan Pipeline AI Penuh; true: Mock Presets)
MOCK_MODE=false

# Environment Mode (production / development)
ENVIRONMENT=production
